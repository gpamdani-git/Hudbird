{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@hudbird/marketing": ["src/index.ts"],
      "@hudbird/marketing/saas": ["src/blocks/SaaS/index.ts"],
      "@hudbird/marketing/fintech": ["src/blocks/Fintech/index.ts"],
      "@hudbird/marketing/ecommerce": ["src/blocks/Ecommerce/index.ts"],
      "@hudbird/marketing/ai": ["src/blocks/AiStartup/index.ts"],
      "@hudbird/marketing/ai-startup": ["src/blocks/AiStartup/index.ts"],
      "@hudbird/marketing/agency": ["src/blocks/Agency/index.ts"],
      "@hudbird/marketing/hospitality": ["src/blocks/Hospitality/index.ts"],
      "@hudbird/marketing/admin": ["src/blocks/AdminCms/index.ts"],
      "@hudbird/marketing/admin-cms": ["src/blocks/AdminCms/index.ts"],
      "@hudbird/marketing/modern-app": ["src/blocks/ModernApp/index.ts"],
      "@hudbird/marketing/3d": ["src/3d/index.ts"],
      "@hudbird/ui": ["../core/src/index.ts"],
      "@hudbird/theme": ["../theme/src/index.js"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
