{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",

    "paths": {
      "@/*": ["./src/*"],
      "@hudbird/ui": ["../../packages/core/src/index.ts"],
      "@hudbird/theme": ["../../packages/theme/src/index.ts"],
      "@hudbird/marketing": ["../../packages/marketing/src/index.ts"],
      "@hudbird/marketing/saas": ["../../packages/marketing/src/blocks/SaaS/index.ts"],
      "@hudbird/marketing/fintech": ["../../packages/marketing/src/blocks/Fintech/index.ts"],
      "@hudbird/marketing/ecommerce": ["../../packages/marketing/src/blocks/Ecommerce/index.ts"],
      "@hudbird/marketing/ai": ["../../packages/marketing/src/blocks/AiStartup/index.ts"],
      "@hudbird/marketing/ai-startup": ["../../packages/marketing/src/blocks/AiStartup/index.ts"],
      "@hudbird/marketing/agency": ["../../packages/marketing/src/blocks/Agency/index.ts"],
      "@hudbird/marketing/hospitality": [
        "../../packages/marketing/src/blocks/Hospitality/index.ts"
      ],
      "@hudbird/marketing/admin": ["../../packages/marketing/src/blocks/AdminCms/index.ts"],
      "@hudbird/marketing/admin-cms": ["../../packages/marketing/src/blocks/AdminCms/index.ts"],
      "@hudbird/marketing/modern-app": ["../../packages/marketing/src/blocks/ModernApp/index.ts"],
      "@hudbird/marketing/3d": ["../../packages/marketing/src/3d/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
