{
  "name": "blankui-monorepo",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "cd starter-kits/saas-launchpad && vite build --base=/saas-launchpad/ && rm -rf ../../public/saas-launchpad && cp -R dist ../../public/saas-launchpad && cd ../../ && vite build",
    "vercel-build": "cd starter-kits/saas-launchpad && vite build --base=/saas-launchpad/ && rm -rf ../../public/saas-launchpad && cp -R dist ../../public/saas-launchpad && cd ../../ && vite build",
    "build:packages": "pnpm --filter './packages/*' build",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky",
    "release": "pnpm build:packages && changeset publish",
    "sync-changelog": "node scripts/sync-changelog.js",
    "bump": "changeset version && pnpm sync-changelog"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
