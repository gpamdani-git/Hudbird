{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@hudbird/ui": ["packages/core/src/index.ts"],
      "@hudbird/theme": ["packages/theme/src/index.ts"],
      "@hudbird/marketing": ["packages/marketing/src/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "packages/**/*", "starter-kits/**/*", "apps/**/*"]
}
